# Optional: server-only key for real road rerouting around reported spots.
# Without this key, the OSRM public demo supplies ordinary car-route alternatives.
# Do not prefix this variable with NEXT_PUBLIC_.
OPENROUTESERVICE_API_KEY=

# SQLite reports and sanitized photo BLOBs are stored together on one server.
# Set this to a durable writable directory when self-hosting.
# Empty uses .data/reports. AWS serverless deployment needs DynamoDB/S3 adapters.
REPORT_STORE_DIR=

# Optional map tile overrides (English-label raster templates; styling is the provider's job).
# The dark template is used in dark mode, the light one in light mode. Without a light
# template, light mode uses the built-in Esri light basemap.
# Optional English-guaranteed layer (Esri Basemap Styles, language=en). Key needs
# "Static basemap tiles"; restrict it by HTTP referrer (it is public in the browser).
NEXT_PUBLIC_ESRI_BASEMAP_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_URL_LIGHT=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
