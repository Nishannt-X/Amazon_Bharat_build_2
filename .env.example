# Optional: server-only key for real road rerouting around reported spots.
# Without this key, the OSRM public demo supplies ordinary car-route alternatives.
# Do not prefix this variable with NEXT_PUBLIC_.
OPENROUTESERVICE_API_KEY=

# SQLite reports and sanitized photo BLOBs are stored together on one server.
# Set this to a durable writable directory when self-hosting.
# Empty uses .data/reports. AWS serverless deployment needs DynamoDB/S3 adapters.
REPORT_STORE_DIR=

# Optional map tile overrides (English-label raster templates; styling is the provider's job).
# The dark template is used in dark mode, the light one in light mode. Without a light
# template, light mode uses the built-in Esri light basemap.
# Optional English-guaranteed layer (Esri Basemap Styles, language=en). Key needs
# "Static basemap tiles"; restrict it by HTTP referrer (it is public in the browser).
NEXT_PUBLIC_ESRI_BASEMAP_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_URL_LIGHT=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Local CV: Python interpreter with scripts/cv/requirements.txt installed.
CV_PYTHON=python3
# Server-side AWS credential chain (profile/role recommended); never NEXT_PUBLIC_.
AWS_REGION=ap-south-1
# Optional vision model or inference profile ID accessible in the chosen region.
# Bedrock extracts scene context only; it cannot certify metric depth.
BEDROCK_VISION_MODEL_ID=
# Optional text model/inference profile: bounded prioritization of server-owned advice.
# Missing/failed provider uses metric and vehicle-specific deterministic rules.
BEDROCK_RECOMMENDATION_MODEL_ID=
# Private S3 bucket for short voice recordings and transcription output.
# Configure lifecycle deletion of voice/ and transcripts/ objects.
TRANSCRIBE_BUCKET=
POLLY_ENABLED=false
POLLY_VOICE_ID=Aditi

# Google Maps API key used server-side to fetch Street View baseline imagery for
# CV flood-depth analysis. Enable "Street View Static API" in Google Cloud Console.
# Do NOT prefix with NEXT_PUBLIC_ — this must never be exposed to the browser.
GOOGLE_MAPS_API_KEY=
