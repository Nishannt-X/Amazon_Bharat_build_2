# Optional: server-only key for real road rerouting around reported spots.
# Without this key, the OSRM public demo supplies ordinary car-route alternatives.
# Do not prefix this variable with NEXT_PUBLIC_.
OPENROUTESERVICE_API_KEY=

# Shared reports currently use a single-server filesystem store.
# Set this to a durable writable directory when self-hosting.
# Serverless deployments require a durable database/object-storage adapter.
REPORT_STORE_DIR=
