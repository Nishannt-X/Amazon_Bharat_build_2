# Optional: server-only key for real road rerouting around reported spots.
OPENROUTESERVICE_API_KEY=

# Optional local report store directory (defaults to .data/reports)
REPORT_STORE_DIR=

# Optional map tile overrides
NEXT_PUBLIC_ESRI_BASEMAP_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_URL_LIGHT=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Local Computer Vision Pipeline
CV_PYTHON=python3
CV_REFERENCE_PYTHON=

# Server-side AWS IAM Credentials (never commit to git or prefix with NEXT_PUBLIC_)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# AWS S3 Evidence Vault for citizen photos & database backups
S3_EVIDENCE_BUCKET=floodflow-evidence-delhi-2026
S3_REGION=ap-southeast-2

# AWS DynamoDB Serverless Cloud Tables
DYNAMODB_REPORTS_TABLE=floodflow_reports
DYNAMODB_ACCOUNTS_TABLE=floodflow_accounts
DYNAMODB_SESSIONS_TABLE=floodflow_sessions
DYNAMODB_GARAGE_TABLE=floodflow_garage
DYNAMODB_ANALYSES_TABLE=floodflow_analyses

# AWS Bedrock Models (Amazon Nova Lite v1:0 exclusively)
BEDROCK_RECOMMENDATION_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_VISION_MODEL_ID=amazon.nova-lite-v1:0
