# Optional: server-only key for real road rerouting around reported spots.
# Without this key, the OSRM public demo supplies ordinary car-route alternatives.
# Do not prefix this variable with NEXT_PUBLIC_.
OPENROUTESERVICE_API_KEY=

# SQLite reports and sanitized photo BLOBs are stored together on one server.
# Set this to a durable writable directory when self-hosting.
# Empty uses .data/reports. AWS serverless deployment needs DynamoDB/S3 adapters.
REPORT_STORE_DIR=

# Local CV: Python interpreter with scripts/cv/requirements.txt installed.
CV_PYTHON=python3
# Server-side AWS credential chain (profile/role recommended); never NEXT_PUBLIC_.
AWS_REGION=ap-south-1
# Optional vision model or inference profile ID accessible in the chosen region.
# Bedrock extracts scene context only; it cannot certify metric depth.
BEDROCK_VISION_MODEL_ID=
# Private S3 bucket for short voice recordings and transcription output.
# Configure lifecycle deletion of voice/ and transcripts/ objects.
TRANSCRIBE_BUCKET=
POLLY_ENABLED=false
POLLY_VOICE_ID=Aditi
