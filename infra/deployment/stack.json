{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "FloodFlow hackathon: app + CPU CV on ECS, HTTPS CloudFront, existing data services, retained state",
  "Parameters": {
    "WebImage": {
      "Type": "String"
    },
    "CvImage": {
      "Type": "String"
    },
    "RuntimeSecretArn": {
      "Type": "String"
    },
    "EvidenceBucket": {
      "Type": "String"
    },
    "TableArns": {
      "Type": "CommaDelimitedList"
    },
    "CloudFrontPrefixList": {
      "Type": "String"
    },
    "OriginToken": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 32
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.67.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "Subnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.67.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "SubnetRoute0": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet0"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "Subnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.67.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "SubnetRoute1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet1"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "AlbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "CloudFront origin traffic only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixList"
            }
          }
        ]
      }
    },
    "TaskSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Web and CV ports from ALB only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "SourceSecurityGroupId": {
              "Ref": "AlbSecurity"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {
              "Ref": "AlbSecurity"
            }
          }
        ]
      }
    },
    "EfsSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Persistent app state from task only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 2049,
            "ToPort": 2049,
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurity"
            }
          }
        ]
      }
    },
    "Filesystem": {
      "Type": "AWS::EFS::FileSystem",
      "Properties": {
        "Encrypted": true,
        "PerformanceMode": "generalPurpose",
        "LifecyclePolicies": [
          {
            "TransitionToIA": "AFTER_30_DAYS"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AccessPoint": {
      "Type": "AWS::EFS::AccessPoint",
      "Properties": {
        "FileSystemId": {
          "Ref": "Filesystem"
        },
        "PosixUser": {
          "Uid": "10001",
          "Gid": "10001"
        },
        "RootDirectory": {
          "Path": "/floodflow",
          "CreationInfo": {
            "OwnerUid": "10001",
            "OwnerGid": "10001",
            "Permissions": "0700"
          }
        }
      }
    },
    "Mount0": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "Filesystem"
        },
        "SubnetId": {
          "Ref": "Subnet0"
        },
        "SecurityGroups": [
          {
            "Ref": "EfsSecurity"
          }
        ]
      }
    },
    "Mount1": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "Filesystem"
        },
        "SubnetId": {
          "Ref": "Subnet1"
        },
        "SecurityGroups": [
          {
            "Ref": "EfsSecurity"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyName": "RuntimeSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "RuntimeSecretArn"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "FloodFlowRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan",
                    "dynamodb:BatchGetItem",
                    "dynamodb:BatchWriteItem"
                  ],
                  "Resource": {
                    "Ref": "TableArns"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:s3:::${EvidenceBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:s3:::${EvidenceBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:InvokeModelWithResponseStream"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:bedrock:${AWS::Region}::foundation-model/amazon.nova-lite-v1:0"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "polly:SynthesizeSpeech",
                    "polly:DescribeVoices"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "elasticfilesystem:ClientMount",
                    "elasticfilesystem:ClientWrite"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Filesystem",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "elasticfilesystem:AccessPointArn": {
                        "Fn::GetAtt": [
                          "AccessPoint",
                          "Arn"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": {
          "Fn::Sub": "${AWS::StackName}"
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/ecs/${AWS::StackName}"
        },
        "RetentionInDays": 7
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "Subnet0"
          },
          {
            "Ref": "Subnet1"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSecurity"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "240"
          }
        ]
      }
    },
    "WebTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 3000,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/api/health",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 10,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "180"
          }
        ]
      }
    },
    "CvTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 10,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "180"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "403",
              "ContentType": "text/plain",
              "MessageBody": "Use the HTTPS endpoint"
            }
          }
        ]
      }
    },
    "CvRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 10,
        "Conditions": [
          {
            "Field": "http-header",
            "HttpHeaderConfig": {
              "HttpHeaderName": "X-Floodflow-Origin",
              "Values": [
                {
                  "Ref": "OriginToken"
                }
              ]
            }
          },
          {
            "Field": "path-pattern",
            "PathPatternConfig": {
              "Values": [
                "/analyze",
                "/health"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "CvTarget"
            }
          }
        ]
      }
    },
    "WebRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 20,
        "Conditions": [
          {
            "Field": "http-header",
            "HttpHeaderConfig": {
              "HttpHeaderName": "X-Floodflow-Origin",
              "Values": [
                {
                  "Ref": "OriginToken"
                }
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "WebTarget"
            }
          }
        ]
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "FloodFlow full app and CV",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "app-alb",
              "DomainName": {
                "Fn::GetAtt": [
                  "Alb",
                  "DNSName"
                ]
              },
              "CustomOriginConfig": {
                "HTTPPort": 80,
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "http-only",
                "OriginReadTimeout": 60
              },
              "OriginCustomHeaders": [
                {
                  "HeaderName": "X-Floodflow-Origin",
                  "HeaderValue": {
                    "Ref": "OriginToken"
                  }
                }
              ]
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "app-alb",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "POST",
              "PATCH",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
            "Compress": true
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "2048",
        "Memory": "8192",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "Volumes": [
          {
            "Name": "state",
            "EFSVolumeConfiguration": {
              "FilesystemId": {
                "Ref": "Filesystem"
              },
              "TransitEncryption": "ENABLED",
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Ref": "AccessPoint"
                },
                "IAM": "ENABLED"
              }
            }
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "cv",
            "Image": {
              "Ref": "CvImage"
            },
            "Essential": true,
            "Cpu": 1536,
            "Memory": 6144,
            "PortMappings": [
              {
                "ContainerPort": 8080
              }
            ],
            "Secrets": [
              {
                "Name": "CV_SERVICE_TOKEN",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:CV_SERVICE_TOKEN::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "service"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "python -c 'import urllib.request; urllib.request.urlopen(\"http://127.0.0.1:8080/health\", timeout=3)'"
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 60
            }
          },
          {
            "Name": "web",
            "Image": {
              "Ref": "WebImage"
            },
            "Essential": true,
            "Cpu": 512,
            "Memory": 2048,
            "PortMappings": [
              {
                "ContainerPort": 3000
              }
            ],
            "DependsOn": [
              {
                "ContainerName": "cv",
                "Condition": "HEALTHY"
              }
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "CV_LOCAL_ENABLED",
                "Value": "false"
              },
              {
                "Name": "CV_SERVICE_URL",
                "Value": "http://127.0.0.1:8080"
              },
              {
                "Name": "CV_SERVICE_TIMEOUT_MS",
                "Value": "240000"
              },
              {
                "Name": "REPORT_STORE_DIR",
                "Value": "/app/.data/reports"
              },
              {
                "Name": "FLOODFLOW_PUBLIC_PROTOCOL",
                "Value": "https"
              }
            ],
            "Secrets": [
              {
                "Name": "CV_SERVICE_TOKEN",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:CV_SERVICE_TOKEN::"
                }
              },
              {
                "Name": "DEEPGRAM_API_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:DEEPGRAM_API_KEY::"
                }
              },
              {
                "Name": "S3_EVIDENCE_BUCKET",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:S3_EVIDENCE_BUCKET::"
                }
              },
              {
                "Name": "S3_REGION",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:S3_REGION::"
                }
              },
              {
                "Name": "BEDROCK_VISION_MODEL_ID",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:BEDROCK_VISION_MODEL_ID::"
                }
              },
              {
                "Name": "BEDROCK_RECOMMENDATION_MODEL_ID",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:BEDROCK_RECOMMENDATION_MODEL_ID::"
                }
              },
              {
                "Name": "POLLY_VOICE_ID",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:POLLY_VOICE_ID::"
                }
              },
              {
                "Name": "POLLY_SPEECH_RATE",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:POLLY_SPEECH_RATE::"
                }
              },
              {
                "Name": "DYNAMODB_REPORTS_TABLE",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:DYNAMODB_REPORTS_TABLE::"
                }
              },
              {
                "Name": "DYNAMODB_REPORTS_ARCHIVE_TABLE",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:DYNAMODB_REPORTS_ARCHIVE_TABLE::"
                }
              },
              {
                "Name": "DYNAMODB_ACCOUNTS_TABLE",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:DYNAMODB_ACCOUNTS_TABLE::"
                }
              },
              {
                "Name": "DYNAMODB_SESSIONS_TABLE",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:DYNAMODB_SESSIONS_TABLE::"
                }
              },
              {
                "Name": "DYNAMODB_GARAGE_TABLE",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:DYNAMODB_GARAGE_TABLE::"
                }
              },
              {
                "Name": "DYNAMODB_ANALYSES_TABLE",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:DYNAMODB_ANALYSES_TABLE::"
                }
              },
              {
                "Name": "GOOGLE_STREETVIEW_API_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:GOOGLE_STREETVIEW_API_KEY::"
                }
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "state",
                "ContainerPath": "/app/.data/reports",
                "ReadOnly": false
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "service"
              }
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "floodflow",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "LaunchType": "FARGATE",
        "DesiredCount": 1,
        "HealthCheckGracePeriodSeconds": 120,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 0,
          "MaximumPercent": 100
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "Subnet0"
              },
              {
                "Ref": "Subnet1"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskSecurity"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Ref": "WebTarget"
            },
            "ContainerName": "web",
            "ContainerPort": 3000
          },
          {
            "TargetGroupArn": {
              "Ref": "CvTarget"
            },
            "ContainerName": "cv",
            "ContainerPort": 8080
          }
        ]
      },
      "DependsOn": [
        "WebRule",
        "CvRule",
        "Mount0",
        "Mount1",
        "InternetRoute"
      ]
    }
  },
  "Outputs": {
    "LiveUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "CvUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "FilesystemId": {
      "Value": {
        "Ref": "Filesystem"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    }
  }
}
